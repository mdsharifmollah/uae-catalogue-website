# ── Database (Postgres) ─────────────────────────────────────────────
# Local:      postgresql://<user>@localhost:5432/ua_fabric
# Production: Neon / Supabase / Railway Postgres connection string
DATABASE_URL=postgresql://user@localhost:5432/ua_fabric

# ── Security ────────────────────────────────────────────────────────
# Long random strings (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=YOUR_SECRET_HERE
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

# Public site URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (optional locally; required on Vercel) ────────────
# Cloudflare R2 or any S3-compatible bucket. Leave S3_BUCKET empty to store uploads in public/media.
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (optional) — quote-form notifications via Resend ──────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=website@yourdomain.com
EMAIL_FROM_NAME=Al Hejlah Website
